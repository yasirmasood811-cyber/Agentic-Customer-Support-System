# Copy this file to .env and fill in your keys. Never commit .env.

# Gemini API (free key from https://aistudio.google.com) -> used by all agents (LLM)
GOOGLE_API_KEY=
# Model name: pick one that is available (and has enough free requests per day) for your key.
# Check the rate-limit page in Google AI Studio. Example: gemini-3.5-flash-lite
LLM_MODEL=

# ---- EMAIL ----
# Option 1 (cloud): Brevo API. Free hosts block SMTP, so use this there.
# Create a free Brevo account, verify a sender address, then make an API key.
BREVO_API_KEY=
EMAIL_SENDER=
# Option 2 (laptop): Gmail SMTP (used when BREVO_API_KEY is empty)
# Needs 2-Step Verification ON, then Google Account > Security > App Passwords
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Support team inbox: receives an email for every new escalation ticket (leave empty to turn off)
SUPPORT_TEAM_EMAIL=

# Password for the admin page (open http://localhost:5173/#admin). Choose a strong one. Empty = admin is disabled.
ADMIN_PASSWORD=

# Stripe TEST mode key (sk_test_...) -> used by process_refund tool
STRIPE_SECRET_KEY=

# Database (PostgreSQL): postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# Use a simple password without special characters like @ or #.
# (For a quick test without PostgreSQL you can use SQLite: sqlite:///./support.db)
DATABASE_URL=postgresql+psycopg2://support_user:your_password@localhost:5432/support

# Optional: only needed if the React app runs on another address (comma separated)
# CORS_ORIGINS=http://localhost:5173

# Optional: LangSmith tracing (free tier)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-agent

# ---- KNOWLEDGE BASE (cloud defaults shown; they need no extra install) ----
# gemini = Gemini embeddings with GOOGLE_API_KEY, memory = rebuilt at every server start
EMBEDDINGS_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
VECTOR_STORE=memory
# On a laptop with the big requirements.txt you can use:  EMBEDDINGS_PROVIDER=local  and  VECTOR_STORE=chroma
